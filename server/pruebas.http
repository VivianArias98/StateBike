# Pruebas de la API. Antes de usar:
# 1) Crea .vscode/settings.json con rest-client.environmentVariables > local
#    (adminCorreo, adminClave, usuarioCorreo, usuarioClave). Ese archivo no se versiona.
# 2) Elige el entorno "local" (Rest Client: Switch Environment).

# Las respuestas con "# @name" quedan guardadas hasta que se vuelva a ejecutar esa petición.
# Para cambiar de administrador a usuario, ejecuta primero el login que quieras usar.

# Las respuestas con "# @name" se reemplazan cada vez que se ejecuta la petición.
# Si repites un registro, la segunda respuesta (409) borra el id guardado.

@host = http://localhost:4000/api

### 1. Registro
POST {{host}}/auth/register
Content-Type: application/json

{
  "nombreCompleto": "Laura Gómez Rojas",
  "fechaNacimiento": "2001-05-14",
  "correo": "{{usuarioCorreo}}",
  "contrasena": "{{usuarioClave}}",
  "confirmacion": "{{usuarioClave}}",
  "aceptaTerminos": true
}

### 2. Login
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{ "correo": "{{usuarioCorreo}}", "contrasena": "{{usuarioClave}}" }

### 3. Perfil con el token
GET {{host}}/auth/me
Authorization: Bearer {{login.response.body.acceso}}

### 4. Login del administrador (el del seed)
POST {{host}}/auth/login
Content-Type: application/json

{ "correo": "{{adminCorreo}}", "contrasena": "{{adminClave}}" }

### 5. Login admin (guarda el token)
# @name adminLogin
POST {{host}}/auth/login
Content-Type: application/json

{ "correo": "{{adminCorreo}}", "contrasena": "{{adminClave}}" }

### 6. Estaciones públicas (sin sesión)
GET {{host}}/estaciones

### 7. Registrar estación
POST {{host}}/admin/estaciones
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{
  "nombre": "Estación centro",
  "direccion": "Cra 20#11-15",
  "capacidad": 12,
  "lat": 5.5353,
  "lng": -73.3678
}

### 8. Listar como administrador
GET {{host}}/admin/estaciones
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 9. Modificar estación 1
PUT {{host}}/admin/estaciones/1
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{ "nombre": "Estación centro", "direccion": "Cra 20#11-20", "lat": 5.536, "lng": -73.368 }

### 10. Inactivar estación 1
PATCH {{host}}/admin/estaciones/1/inactivar
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 11. Estaciones públicas con búsqueda
GET {{host}}/estaciones?q=centro

### 12. Ruta de admin con token de USUARIO (debe dar 403)
GET {{host}}/admin/estaciones
Authorization: Bearer {{login.response.body.acceso}}

### 13. Crear estación de prueba (2 anclajes)
# @name estacion
POST {{host}}/admin/estaciones
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{ "nombre": "Estación Plaza", "direccion": "Cra 9 #19-00", "capacidad": 2, "lat": 5.5345, "lng": -73.3675 }

### 14. Registrar bicicleta 1
# @name bici1
POST {{host}}/admin/bicicletas
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{ "codigo": "BIC-0001", "estacionId": {{estacion.response.body.estacion.id}} }

### 15. Registrar bicicleta 2
POST {{host}}/admin/bicicletas
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{ "codigo": "BIC-0002", "estacionId": {{estacion.response.body.estacion.id}} }

### 16. Registrar bicicleta 3 (sin anclajes libres)
POST {{host}}/admin/bicicletas
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{ "codigo": "BIC-0003", "estacionId": {{estacion.response.body.estacion.id}} }

### 17. Código repetido
POST {{host}}/admin/bicicletas
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{ "codigo": "bic-0001", "estacionId": {{estacion.response.body.estacion.id}} }

### 18. Listar y buscar
GET {{host}}/admin/bicicletas?q=0001
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 19. Enviar bicicleta 1 a mantenimiento
PUT {{host}}/admin/bicicletas/{{bici1.response.body.bicicleta.id}}
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{ "estado": "MANTENIMIENTO" }

### 20. Estaciones: cupos actualizados
GET {{host}}/admin/estaciones
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 21. Intentar inactivar la estación (tiene bicicletas)
PATCH {{host}}/admin/estaciones/{{estacion.response.body.estacion.id}}/inactivar
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 22. Inactivar bicicleta 1
PATCH {{host}}/admin/bicicletas/{{bici1.response.body.bicicleta.id}}/inactivar
Authorization: Bearer {{adminLogin.response.body.acceso}}

# Id del plan de prueba 
@planId = 5

### 23. Planes públicos (sin sesión)
GET {{host}}/planes

### 24. Planes como administrador
GET {{host}}/admin/planes
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 25. Registrar plan
POST {{host}}/admin/planes
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{
  "nombre": "Plan Test",
  "costoBase": 90000,
  "vigenciaDias": 0,
  "viajesPorDia": 4,
  "tiempoViajeMin": 45,
  "valorMinutoExceso": 0
}

### 26. Modificar plan
PUT {{host}}/admin/planes/{{planId}}
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{
  "nombre": "Plan Trimestral",
  "costoBase": 85000,
  "vigenciaDias": 90,
  "viajesPorDia": 4,
  "tiempoViajeMin": 45,
  "valorMinutoExceso": 0
}

### 27. Inactivar plan
PATCH {{host}}/admin/planes/{{planId}}/inactivar
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 28. Activar plan
PATCH {{host}}/admin/planes/{{planId}}/activar
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 30. Admin: usuarios con su estado de tarjeta
GET {{host}}/admin/tarjetas
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 31. Admin: vincular tarjeta al usuario de prueba
POST {{host}}/admin/tarjetas
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{ "usuarioId": {{login.response.body.usuario.id}}, "uid": "04A1B2C3" }

### 32. Admin: vincular otra al mismo usuario (debe fallar)
POST {{host}}/admin/tarjetas
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{ "usuarioId": {{login.response.body.usuario.id}}, "uid": "04D4E5F6" }

### 33. Usuario: mi tarjeta
GET {{host}}/tarjeta
Authorization: Bearer {{login.response.body.acceso}}

### 34. Usuario: bloquear
PATCH {{host}}/tarjeta/bloquear
Authorization: Bearer {{login.response.body.acceso}}

### 35. Usuario: desbloquear
PATCH {{host}}/tarjeta/desbloquear
Authorization: Bearer {{login.response.body.acceso}}

### 36. Admin: buscar por correo
GET {{host}}/admin/tarjetas?q=prueba
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 37. Admin: desvincular
DELETE {{host}}/admin/tarjetas/{{login.response.body.usuario.id}}
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 38. Permisos: vincular con el token de un usuario común (debe dar 403)
POST {{host}}/admin/tarjetas
Authorization: Bearer {{login.response.body.acceso}}
Content-Type: application/json

{ "usuarioId": 1, "uid": "04A1B2C3" }

### 39. Usuario: consultar mi plan actual (HU_17)
GET {{host}}/planes/mi-plan
Authorization: Bearer {{login.response.body.acceso}}

### 40. Usuario: adquirir plan con saldo de billetera (HU_2)
POST {{host}}/planes/adquirir
Authorization: Bearer {{login.response.body.acceso}}
Content-Type: application/json

{ "planId": 2 }

### 41. Usuario: cancelar plan activo sin reembolso (HU_2)
POST {{host}}/planes/cancelar
Authorization: Bearer {{login.response.body.acceso}}

### 42. Usuario: consultar historial de viajes (HU_5)
GET {{host}}/historial/viajes
Authorization: Bearer {{login.response.body.acceso}}

### 43. Usuario: historial de viajes con filtro de fechas válido (HU_5)
GET {{host}}/historial/viajes?desde=2026-10-01&hasta=2026-11-30
Authorization: Bearer {{login.response.body.acceso}}

### 44. Usuario: historial con rango de fechas inválido (debe dar 400 fecha_invalida_rango)
GET {{host}}/historial/viajes?desde=2026-11-30&hasta=2026-10-01
Authorization: Bearer {{login.response.body.acceso}}

### 45. Usuario: consultar historial de pagos (HU_5)
GET {{host}}/historial/pagos
Authorization: Bearer {{login.response.body.acceso}}

### 46. Usuario: consultar billetera y estado de cobros (HU_23)
GET {{host}}/billetera
Authorization: Bearer {{login.response.body.acceso}}

### 47. Usuario: recargar saldo en billetera (HU_24)
POST {{host}}/billetera/recargar
Authorization: Bearer {{login.response.body.acceso}}
Content-Type: application/json

{ "monto": 50000 }

### 48. Usuario: recarga con monto inválido fuera de rango (debe dar 400)
POST {{host}}/billetera/recargar
Authorization: Bearer {{login.response.body.acceso}}
Content-Type: application/json

{ "monto": 50 }

### 49. Usuario: pagar cobro pendiente por exceso (HU_25)
POST {{host}}/billetera/pagar-cobro
Authorization: Bearer {{login.response.body.acceso}}

### 50. Usuario: reportar daño o incidencia en bicicleta (HU_6)
POST {{host}}/incidencias
Authorization: Bearer {{login.response.body.acceso}}
Content-Type: application/json

{
  "tipo": "BICICLETA",
  "bicicletaId": 1,
  "descripcion": "Freno trasero desajustado y cadena suelta"
}

### 51. Usuario: consultar mis incidencias reportadas (HU_6)
GET {{host}}/incidencias
Authorization: Bearer {{login.response.body.acceso}}

### 52. Admin: listar todas las incidencias (HU_19)
GET {{host}}/admin/incidencias
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 53. Admin: atender incidencia con observación obligatoria (HU_19)
PATCH {{host}}/admin/incidencias/1/atender
Authorization: Bearer {{adminLogin.response.body.acceso}}
Content-Type: application/json

{ "observacion": "Bicicleta ingresada al taller para ajuste técnico" }

### 54. Admin: cerrar incidencia previamente atendida (HU_19)
PATCH {{host}}/admin/incidencias/1/cerrar
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 55. Permisos: intentar atender incidencia con token de usuario común (debe dar 403)
PATCH {{host}}/admin/incidencias/1/atender
Authorization: Bearer {{login.response.body.acceso}}
Content-Type: application/json

{ "observacion": "Intento no autorizado" }

### 56. Usuario: consultar mi perfil propio (HU_1)
GET {{host}}/perfil
Authorization: Bearer {{login.response.body.acceso}}

### 57. Usuario: editar nombre y teléfono de mi perfil (HU_1)
PUT {{host}}/perfil
Authorization: Bearer {{login.response.body.acceso}}
Content-Type: application/json

{
  "nombreCompleto": "Laura Gómez Rojas",
  "telefono": "3201234567"
}

### 58. Admin: listar cuentas de usuario registradas (HU_21)
GET {{host}}/admin/cuentas
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 59. Admin: buscar usuario por correo o nombre (HU_21)
GET {{host}}/admin/cuentas?busqueda=prueba
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 60. Admin: inactivar cuenta de usuario (HU_21)
PATCH {{host}}/admin/cuentas/{{login.response.body.usuario.id}}/inactivar
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 61. Admin: reactivar cuenta de usuario (HU_21)
PATCH {{host}}/admin/cuentas/{{login.response.body.usuario.id}}/reactivar
Authorization: Bearer {{adminLogin.response.body.acceso}}

### 62. Permisos: usuario común intentar inactivar una cuenta (debe dar 403)
PATCH {{host}}/admin/cuentas/1/inactivar
Authorization: Bearer {{login.response.body.acceso}}

### 63. Terminal NFC: iniciar viaje / retiro de bicicleta en estación (HU_3)
POST {{host}}/interno/retiros
X-Clave-Interna: 7d9f2e4b8a1c3d5e6f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e
Content-Type: application/json

{
  "anclajeId": 1,
  "uid": "04A1B2C3"
}

### 64. Usuario: consultar estado de mi viaje en curso
GET {{host}}/viajes/en-curso
Authorization: Bearer {{login.response.body.acceso}}

### 65. Terminal NFC: devolver bicicleta y finalizar viaje (HU_4)
POST {{host}}/interno/devoluciones
X-Clave-Interna: 7d9f2e4b8a1c3d5e6f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e
Content-Type: application/json

{
  "anclajeId": 2,
  "uid": "04A1B2C3",
  "bloqueoDetectado": true
}

### 66. Terminal NFC: devolver bicicleta sin bloqueo detectado (debe dar 400)
POST {{host}}/interno/devoluciones
X-Clave-Interna: 7d9f2e4b8a1c3d5e6f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e
Content-Type: application/json

{
  "anclajeId": 2,
  "uid": "04A1B2C3",
  "bloqueoDetectado": false
}

### 67. Terminal NFC: devolver sin viaje en curso (debe dar 400 sin_viaje_en_curso)
POST {{host}}/interno/devoluciones
X-Clave-Interna: 7d9f2e4b8a1c3d5e6f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e
Content-Type: application/json

{
  "anclajeId": 2,
  "uid": "04A1B2C3",
  "bloqueoDetectado": true
}