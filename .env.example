PORT=4000
NODE_ENV=development
FRONT_ORIGIN=http://localhost:5173
DB_FILE=./server/data/stationbike.db

# Conexión con TunjaAPI
TUNJA_API=https://nfc.multimediaudeb.com/api/v1
TUNJA_CLAVE=tk_clave

# Clave compartida con la API NFC (debe ser idéntica en los dos .env)
CLAVE_INTERNA=pega_aqui_la_clave_generada

# Administrador inicial para la base de datos (requerido por npm run seed)
ADMIN_EMAIL=tu_correo_admin@ejemplo.com
ADMIN_PASSWORD=TuClaveSegura123*
ADMIN_NOMBRE=Nombre Administrador